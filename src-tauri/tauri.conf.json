{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sagwan",
  "version": "0.1.0",
  "identifier": "com.chann.sagwan",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sagwan",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "targets": ["app"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
