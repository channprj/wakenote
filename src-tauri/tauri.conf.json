{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WakeNote",
  "version": "0.260803.1",
  "identifier": "com.chann.wakenote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WakeNote",
        "width": 1040,
        "height": 922,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "targets": ["app"],
    "category": "Productivity",
    "resources": {
      "../src/assets/sounds/dict-end-0.mp3": "dict-end-0.mp3",
      "../src/assets/sounds/dict-start-0.mp3": "dict-start-0.mp3",
      "resources/dictation-start.wav": "dictation-start.wav",
      "resources/dictation-stop.wav": "dictation-stop.wav"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
